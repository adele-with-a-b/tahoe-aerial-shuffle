{
  "title": "Aerial Shuffle lock screen keys",
  "rules": [
    {
      "description": "ESC on the lock screen turns the displays off",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "aerial_screen_locked",
              "value": 1
            }
          ],
          "from": {
            "key_code": "escape",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to_after_key_up": [
            {
              "shell_command": "'@BIN@/esc-if-locked'"
            }
          ]
        }
      ]
    },
    {
      "description": "Ctrl+Cmd+Q starts the screensaver, which plays on every display",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "q",
            "modifiers": {
              "mandatory": [
                "control",
                "command"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -a ScreenSaverEngine"
            }
          ]
        }
      ]
    }
  ]
}
